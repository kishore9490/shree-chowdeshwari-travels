---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Shree Chowdeshwari Tours & Travels | Official Launch 29 September 2026",
  description = "Something extraordinary is about to begin. Shree Chowdeshwari Tours & Travels launches on 29 September 2026. Bespoke luxury holidays, sacred pilgrimages, and royal fleet journeys.",
  image = "/images/sct-logo-transparent.png",
  canonicalUrl = "https://shreechowdeshwari.com",
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Shree Chowdeshwari Tours & Travels",
  "image": "https://shreechowdeshwari.com/images/sct-logo-transparent.png",
  "@id": "https://shreechowdeshwari.com",
  "url": "https://shreechowdeshwari.com",
  "description": description,
  "telephone": "+91-9972621002",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bangalore",
    "addressLocality": "Bangalore",
    "addressRegion": "Karnataka",
    "addressCountry": "IN"
  }
};
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth bg-[#050811] text-[#F8FAFC] antialiased selection:bg-[#F59E0B]/30 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/images/sct-logo-transparent.png" />
    <link rel="apple-touch-icon" href="/images/sct-logo-transparent.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#050811" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Shree Chowdeshwari Tours & Travels" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Shree Chowdeshwari Tours & Travels" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Modern Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <style is:global>
      :root {
        --color-bg: #050811;
        --color-surface: #0B1120;
        --color-gold: #F59E0B;
        --color-gold-light: #FDE68A;
        --color-gold-glow: rgba(245, 158, 11, 0.25);
        --color-blue-glow: rgba(37, 99, 235, 0.25);
      }

      html, body {
        background-color: #050811;
        color: #F8FAFC;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
        min-height: 100%;
        min-height: 100svh;
      }

      /* Font Family Classes */
      .font-heading {
        font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      }
      .font-cinzel {
        font-family: 'Cinzel', serif;
      }
      .font-signature {
        font-family: 'Alex Brush', cursive;
      }
      .font-editorial {
        font-family: 'Cormorant Garamond', Georgia, serif;
      }
      .font-mono-tech {
        font-family: 'Space Grotesk', ui-monospace, monospace;
      }

      /* Modern 2026 Glassmorphism */
      .glass-panel {
        background: rgba(11, 17, 32, 0.75);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }

      .glass-gold-panel {
        background: linear-gradient(135deg, rgba(20, 28, 48, 0.85) 0%, rgba(11, 17, 32, 0.95) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(245, 158, 11, 0.3);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(245, 158, 11, 0.1), inset 0 1px 0 rgba(253, 230, 138, 0.2);
      }

      .glass-pill {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      }

      /* Metallic & Gold Gradient Text */
      .text-gradient-gold {
        background: linear-gradient(135deg, #FFFFFF 0%, #FDE68A 30%, #F59E0B 70%, #D97706 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .text-gradient-silver {
        background: linear-gradient(135deg, #FFFFFF 0%, #E2E8F0 50%, #94A3B8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Aurora background animation */
      @keyframes auroraGlow {
        0%, 100% { transform: scale(1) translate(0px, 0px); opacity: 0.35; }
        50% { transform: scale(1.15) translate(20px, -15px); opacity: 0.6; }
      }
      .animate-aurora {
        animation: auroraGlow 12s ease-in-out infinite alternate;
      }

      /* Flight Keyframe Animations */
      @keyframes flight1 {
        0% { transform: translate3d(-100px, 750px, 0) rotate(15deg) scale(0.8); opacity: 0; }
        10% { opacity: 0.9; }
        80% { opacity: 0.9; }
        100% { transform: translate3d(1400px, 80px, 0) rotate(22deg) scale(1.1); opacity: 0; }
      }
      @keyframes flight2 {
        0% { transform: translate3d(-120px, 120px, 0) rotate(35deg) scale(0.6); opacity: 0; }
        15% { opacity: 0.8; }
        85% { opacity: 0.8; }
        100% { transform: translate3d(1400px, 780px, 0) rotate(42deg) scale(0.9); opacity: 0; }
      }

      /* Safe area insets */
      .safe-top {
        padding-top: max(1rem, env(safe-area-inset-top));
      }
      .safe-bottom {
        padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #050811;
      }
      ::-webkit-scrollbar-thumb {
        background: #1E293B;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #334155;
      }
    </style>
  </head>
  <body class="relative min-h-[100svh] flex flex-col justify-between overflow-x-hidden antialiased pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)]">
    <!-- Ambient Travel Animation Backdrop -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Spotlights -->
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[600px] sm:w-[900px] h-[450px] sm:h-[600px] bg-gradient-to-b from-blue-600/20 via-amber-500/10 to-transparent rounded-full blur-[100px] sm:blur-[140px] animate-aurora"></div>
      <div class="absolute top-1/2 -left-[15%] w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-indigo-600/15 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-0 right-[2%] w-[400px] sm:w-[600px] h-[300px] sm:h-[400px] bg-amber-600/15 rounded-full blur-[120px]"></div>

      <!-- 1. Rotating Celestial Astrolabe / Navigational Compass -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[850px] md:w-[1050px] h-[600px] sm:h-[850px] md:h-[1050px] opacity-[0.07] sm:opacity-[0.11] pointer-events-none animate-[spin_120s_linear_infinite]">
        <svg viewBox="0 0 1000 1000" class="w-full h-full stroke-amber-300" fill="none">
          <circle cx="500" cy="500" r="480" stroke-width="1" stroke-dasharray="6 6" />
          <circle cx="500" cy="500" r="440" stroke-width="1.5" />
          <circle cx="500" cy="500" r="380" stroke-width="1" stroke-dasharray="3 3" />
          <circle cx="500" cy="500" r="280" stroke-width="1" />
          <circle cx="500" cy="500" r="180" stroke-width="1" stroke-dasharray="8 8" />
          <line x1="500" y1="20" x2="500" y2="980" stroke-width="1" stroke-opacity="0.6" />
          <line x1="20" y1="500" x2="980" y2="500" stroke-width="1" stroke-opacity="0.6" />
          <line x1="160" y1="160" x2="840" y2="840" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.4" />
          <line x1="160" y1="840" x2="840" y2="160" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.4" />
          <polygon points="500,60 520,480 940,500 520,520 500,940 480,520 60,500 480,480" stroke-width="1" fill="rgba(245, 158, 11, 0.02)" />
        </svg>
      </div>

      <!-- 2. Animated SVG Flight Paths -->
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="astroFlightGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F59E0B" stop-opacity="0" />
            <stop offset="50%" stop-color="#FDE68A" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#F59E0B" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="astroFlightGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#3B82F6" stop-opacity="0" />
            <stop offset="50%" stop-color="#93C5FD" stop-opacity="0.3" />
            <stop offset="100%" stop-color="#F59E0B" stop-opacity="0" />
          </linearGradient>
        </defs>

        <path d="M -100 800 Q 400 200 1600 100" fill="none" stroke="url(#astroFlightGrad1)" stroke-width="2" stroke-dasharray="8 8" class="opacity-70">
          <animate attributeName="stroke-dashoffset" from="0" to="-200" dur="20s" repeatCount="indefinite" />
        </path>

        <path d="M -100 150 Q 800 600 1600 850" fill="none" stroke="url(#astroFlightGrad2)" stroke-width="1.5" stroke-dasharray="6 6" class="opacity-60">
          <animate attributeName="stroke-dashoffset" from="0" to="-180" dur="25s" repeatCount="indefinite" />
        </path>
      </svg>

      <!-- Flying Golden Jetliner 1 -->
      <div class="absolute w-6 sm:w-8 h-6 sm:h-8 text-amber-300 drop-shadow-[0_0_8px_rgba(245,158,11,0.8)] pointer-events-none animate-[flight1_22s_linear_infinite]">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-full h-full transform rotate-[25deg]">
          <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
        </svg>
      </div>

      <!-- Flying Golden Jetliner 2 -->
      <div class="absolute w-5 sm:w-6 h-5 sm:h-6 text-amber-200/80 drop-shadow-[0_0_6px_rgba(253,230,138,0.7)] pointer-events-none animate-[flight2_30s_linear_infinite]">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-full h-full transform rotate-[40deg]">
          <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
        </svg>
      </div>

      <!-- 3. Ambient Stardust Particles Canvas -->
      <canvas id="astro-particles-canvas" class="absolute inset-0 w-full h-full opacity-60"></canvas>

      <!-- Dot matrix -->
      <div class="absolute inset-0 bg-[radial-gradient(#ffffff06_1px,transparent_1px)] [background-size:20px_20px] opacity-40"></div>
    </div>

    <!-- Main Content Slot -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Service Worker for PWA -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      // Particle Canvas Engine
      const canvas = document.getElementById('astro-particles-canvas') as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          let width = (canvas.width = window.innerWidth);
          let height = (canvas.height = window.innerHeight);

          window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
          });

          const particleCount = window.innerWidth < 640 ? 20 : 38;
          const particles: Array<{ x: number; y: number; radius: number; speedY: number; speedX: number; opacity: number; pulse: number }> = [];

          for (let i = 0; i < particleCount; i++) {
            particles.push({
              x: Math.random() * width,
              y: Math.random() * height,
              radius: Math.random() * 1.6 + 0.5,
              speedY: Math.random() * 0.4 + 0.15,
              speedX: (Math.random() - 0.5) * 0.25,
              opacity: Math.random() * 0.7 + 0.2,
              pulse: Math.random() * 0.02 + 0.005,
            });
          }

          function renderParticles() {
            if (!ctx) return;
            ctx.clearRect(0, 0, width, height);

            particles.forEach((p) => {
              p.y -= p.speedY;
              p.x += p.speedX;
              p.opacity += Math.sin(Date.now() * p.pulse) * 0.005;

              if (p.y < 0) {
                p.y = height + 10;
                p.x = Math.random() * width;
              }
              if (p.x < 0) p.x = width;
              if (p.x > width) p.x = 0;

              ctx.beginPath();
              ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(245, 158, 11, ${Math.max(0.1, Math.min(0.8, p.opacity))})`;
              ctx.shadowBlur = 8;
              ctx.shadowColor = '#F59E0B';
              ctx.fill();
            });

            requestAnimationFrame(renderParticles);
          }
          renderParticles();
        }
      }
    </script>
  </body>
</html>
