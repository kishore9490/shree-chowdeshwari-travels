---
import { mockDatabase } from '../../../../backend/src/data/mockDatabase';

const vehicles = mockDatabase.vehicles;
const drivers = mockDatabase.drivers;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fleet &amp; Driver Operations Matrix | Shree Chowdeshwari Travels</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #060B18; color: #F8F9FA; }
      .font-serif { font-family: 'Playfair Display', serif; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Top Bar -->
    <header class="bg-[#0A1128] border-b border-slate-800 px-6 py-4 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center gap-4">
        <a href="/admin" class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 p-0.5">
            <div class="w-full h-full bg-[#0A1128] rounded-[6px] flex items-center justify-center font-serif font-bold text-amber-400 text-sm">
              SCT
            </div>
          </div>
          <div>
            <span class="font-serif font-bold text-sm text-white block">SHREE CHOWDESHWARI</span>
            <span class="text-[9px] uppercase tracking-wider text-amber-400 font-semibold block">FLEET &amp; DRIVER COMPLIANCE</span>
          </div>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-1 text-xs">
        <a href="/admin" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Executive Overview
        </a>
        <a href="/admin/leads" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          CRM &amp; Leads Kanban
        </a>
        <a href="/admin/fleet" class="px-3.5 py-2 bg-amber-400/10 text-amber-400 font-bold rounded-lg border border-amber-500/30">
          Fleet &amp; Drivers
        </a>
        <a href="/admin/dispatch" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Live Dispatch
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/" class="text-xs text-slate-400 hover:text-white">&larr; Public Site</a>
      </div>
    </header>

    <main class="flex-grow p-6 sm:p-8 max-w-7xl mx-auto w-full space-y-8">
      <div>
        <h1 class="font-serif font-black text-2xl text-white">Verified Vehicles &amp; Chauffeur Compliance</h1>
        <p class="text-xs text-slate-400 mt-1">Real-time tracking of vehicle fitness, insurance, PUC, and driver rosters</p>
      </div>

      <!-- Vehicle Matrix Table -->
      <div class="rounded-2xl bg-[#0A1128] border border-slate-800 overflow-hidden">
        <div class="p-5 border-b border-slate-800 flex justify-between items-center">
          <h3 class="font-serif font-bold text-lg text-white">Company-Owned Vehicle Fleet</h3>
          <span class="text-xs text-amber-400">{vehicles.length} Active Vehicles</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-[#060B18] text-slate-400 uppercase tracking-wider text-[10px] border-b border-slate-800">
              <tr>
                <th class="p-4">Reg Number</th>
                <th class="p-4">Vehicle Model</th>
                <th class="p-4">Class</th>
                <th class="p-4">Capacity</th>
                <th class="p-4">Assigned Driver</th>
                <th class="p-4">Insurance Expiry</th>
                <th class="p-4">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              {vehicles.map(v => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-4 font-mono font-bold text-amber-400">{v.registrationNumber}</td>
                  <td class="p-4 font-semibold text-white">{v.make} {v.model}</td>
                  <td class="p-4">{v.vehicleType}</td>
                  <td class="p-4">{v.seatingCapacity} Seater</td>
                  <td class="p-4 text-slate-200">{v.assignedDriver}</td>
                  <td class="p-4 font-mono text-emerald-400">{v.insuranceExpiry}</td>
                  <td class="p-4">
                    <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                      v.status === 'AVAILABLE' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' :
                      v.status === 'ON_TRIP' ? 'bg-blue-500/20 text-blue-400 border border-blue-500/40' :
                      'bg-amber-500/20 text-amber-400 border border-amber-500/40'
                    }`}>
                      {v.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Drivers Matrix Table -->
      <div class="rounded-2xl bg-[#0A1128] border border-slate-800 overflow-hidden">
        <div class="p-5 border-b border-slate-800 flex justify-between items-center">
          <h3 class="font-serif font-bold text-lg text-white">Licensed Chauffeurs &amp; Background Verification</h3>
          <span class="text-xs text-amber-400">{drivers.length} Verified Drivers</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-[#060B18] text-slate-400 uppercase tracking-wider text-[10px] border-b border-slate-800">
              <tr>
                <th class="p-4">Driver Code</th>
                <th class="p-4">Chauffeur Name</th>
                <th class="p-4">Mobile</th>
                <th class="p-4">Experience</th>
                <th class="p-4">License Type</th>
                <th class="p-4">License Expiry</th>
                <th class="p-4">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              {drivers.map(d => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-4 font-mono font-bold text-amber-400">{d.driverCode}</td>
                  <td class="p-4 font-semibold text-white">{d.fullName}</td>
                  <td class="p-4 font-mono">{d.mobile}</td>
                  <td class="p-4">{d.experienceYears} Years</td>
                  <td class="p-4">{d.licenseType}</td>
                  <td class="p-4 font-mono text-emerald-400">{d.licenseExpiry}</td>
                  <td class="p-4">
                    <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                      d.status === 'AVAILABLE' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' :
                      d.status === 'ON_TRIP' ? 'bg-blue-500/20 text-blue-400 border border-blue-500/40' :
                      'bg-amber-500/20 text-amber-400 border border-amber-500/40'
                    }`}>
                      {d.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>
