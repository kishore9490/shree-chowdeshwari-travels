---
import { mockDatabase } from '../../../../backend/src/data/mockDatabase';

const metrics = {
  totalRevenue: mockDatabase.bookings.reduce((sum, b) => sum + b.netAmount, 0),
  totalBookings: mockDatabase.bookings.length,
  activeLeads: mockDatabase.leads.length,
  availableFleet: mockDatabase.vehicles.filter(v => v.status === 'AVAILABLE').length,
  totalFleet: mockDatabase.vehicles.length,
  activeTrips: mockDatabase.trips.filter(t => t.status === 'IN_PROGRESS' || t.status === 'SCHEDULED').length
};

const recentBookings = mockDatabase.bookings.slice(0, 5);
const recentLeads = mockDatabase.leads.slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Executive Operations Dashboard | Shree Chowdeshwari Travels</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #060B18; color: #F8F9FA; }
      .font-serif { font-family: 'Playfair Display', serif; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Top Bar -->
    <header class="bg-[#0A1128] border-b border-slate-800 px-6 py-4 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 p-0.5">
            <div class="w-full h-full bg-[#0A1128] rounded-[6px] flex items-center justify-center font-serif font-bold text-amber-400 text-sm">
              SCT
            </div>
          </div>
          <div>
            <span class="font-serif font-bold text-sm text-white block">SHREE CHOWDESHWARI</span>
            <span class="text-[9px] uppercase tracking-wider text-amber-400 font-semibold block">OPERATIONS SUITE</span>
          </div>
        </a>
      </div>

      <!-- Navigation Tabs -->
      <nav class="hidden md:flex items-center gap-1 text-xs">
        <a href="/admin" class="px-3.5 py-2 bg-amber-400/10 text-amber-400 font-bold rounded-lg border border-amber-500/30">
          Executive Overview
        </a>
        <a href="/admin/leads" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          CRM &amp; Leads Kanban
        </a>
        <a href="/admin/fleet" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Fleet &amp; Drivers
        </a>
        <a href="/admin/dispatch" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Live Dispatch
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/" class="text-xs text-slate-400 hover:text-white flex items-center gap-1">
          <span>&larr; Public Site</span>
        </a>
        <div class="w-8 h-8 rounded-full bg-amber-500/20 border border-amber-500 text-amber-400 flex items-center justify-center text-xs font-bold">
          AD
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow p-6 sm:p-8 max-w-7xl mx-auto w-full space-y-8">
      <!-- Welcome Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="font-serif font-black text-2xl sm:text-3xl text-white">
            Operations &amp; Revenue Overview
          </h1>
          <p class="text-xs text-slate-400 mt-1">
            Real-time telemetry for Shree Chowdeshwari Tours and Travels &bull; Fiscal Year 2026
          </p>
        </div>

        <div class="flex gap-2">
          <a href="/admin/leads" class="px-4 py-2 bg-amber-400 text-slate-950 text-xs font-bold uppercase rounded-lg hover:bg-amber-300 shadow-md">
            + New Lead / Inquiry
          </a>
        </div>
      </div>

      <!-- KPI Metrics Row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
        <div class="rounded-2xl p-5 bg-[#0A1128] border border-slate-800">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Total Bookings Value</span>
          <span class="font-serif font-black text-2xl text-amber-400">
            ₹{metrics.totalRevenue.toLocaleString('en-IN')}
          </span>
          <span class="text-[10px] text-emerald-400 block mt-1">↑ 24% vs last month</span>
        </div>

        <div class="rounded-2xl p-5 bg-[#0A1128] border border-slate-800">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Active Pipeline Leads</span>
          <span class="font-serif font-black text-2xl text-white">
            {metrics.activeLeads} Leads
          </span>
          <span class="text-[10px] text-amber-400 block mt-1">5 High-Value Inquiries</span>
        </div>

        <div class="rounded-2xl p-5 bg-[#0A1128] border border-slate-800">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Fleet Readiness</span>
          <span class="font-serif font-black text-2xl text-white">
            {metrics.availableFleet} / {metrics.totalFleet}
          </span>
          <span class="text-[10px] text-emerald-400 block mt-1">100% Verified Own Vehicles</span>
        </div>

        <div class="rounded-2xl p-5 bg-[#0A1128] border border-slate-800">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Dispatched On-Trip</span>
          <span class="font-serif font-black text-2xl text-amber-400">
            {metrics.activeTrips} Trips
          </span>
          <span class="text-[10px] text-blue-400 block mt-1">GPS Telemetry Active</span>
        </div>
      </div>

      <!-- Dual Table Grid: Recent Bookings & CRM Pipeline -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Recent Bookings -->
        <div class="rounded-2xl bg-[#0A1128] border border-slate-800 p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif font-bold text-lg text-white">Recent Confirmed Bookings</h3>
            <span class="text-xs text-amber-400 font-semibold">{recentBookings.length} Active</span>
          </div>

          <div class="space-y-3">
            {recentBookings.map(b => (
              <div class="p-3.5 rounded-xl bg-[#060B18] border border-slate-800/80 flex items-center justify-between text-xs">
                <div>
                  <span class="font-mono font-bold text-amber-400 block">{b.bookingReference}</span>
                  <span class="font-semibold text-white">{b.customerName}</span>
                  <span class="text-slate-400 text-[11px] block">{b.tourTitle} ({b.guestsCount} Pax)</span>
                </div>
                <div class="text-right">
                  <span class="font-serif font-bold text-white block">₹{b.netAmount.toLocaleString('en-IN')}</span>
                  <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                    {b.status}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- CRM Leads -->
        <div class="rounded-2xl bg-[#0A1128] border border-slate-800 p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif font-bold text-lg text-white">Active Lead Pipeline</h3>
            <a href="/admin/leads" class="text-xs text-amber-400 font-semibold underline">View Kanban &rarr;</a>
          </div>

          <div class="space-y-3">
            {recentLeads.map(l => (
              <div class="p-3.5 rounded-xl bg-[#060B18] border border-slate-800/80 flex items-center justify-between text-xs">
                <div>
                  <span class="font-mono text-slate-400 text-[10px] block">{l.leadCode}</span>
                  <span class="font-semibold text-white">{l.fullName}</span>
                  <span class="text-amber-400 text-[11px] block">{l.destination} &bull; {l.travellersCount} Pax</span>
                </div>
                <div class="text-right">
                  <span class="text-slate-300 font-serif block">₹{(l.estimatedBudget || 0).toLocaleString('en-IN')}</span>
                  <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                    {l.status}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
