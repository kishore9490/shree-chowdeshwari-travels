---
import { mockDatabase } from '../../../../backend/src/data/mockDatabase';

const leads = mockDatabase.leads;

const stages = [
  { id: 'NEW', title: 'New Inquiries', color: 'border-amber-400 text-amber-400' },
  { id: 'CONTACTED', title: 'Contacted / Follow-up', color: 'border-blue-400 text-blue-400' },
  { id: 'QUOTATION', title: 'Quotation Sent', color: 'border-purple-400 text-purple-400' },
  { id: 'NEGOTIATION', title: 'Negotiation', color: 'border-indigo-400 text-indigo-400' },
  { id: 'WON', title: 'Won / Booked', color: 'border-emerald-400 text-emerald-400' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CRM Lead Pipeline &amp; Kanban | Shree Chowdeshwari Travels</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #060B18; color: #F8F9FA; }
      .font-serif { font-family: 'Playfair Display', serif; }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Top Bar -->
    <header class="bg-[#0A1128] border-b border-slate-800 px-6 py-4 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center gap-4">
        <a href="/admin" class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 p-0.5">
            <div class="w-full h-full bg-[#0A1128] rounded-[6px] flex items-center justify-center font-serif font-bold text-amber-400 text-sm">
              SCT
            </div>
          </div>
          <div>
            <span class="font-serif font-bold text-sm text-white block">SHREE CHOWDESHWARI</span>
            <span class="text-[9px] uppercase tracking-wider text-amber-400 font-semibold block">CRM &amp; LEADS KANBAN</span>
          </div>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-1 text-xs">
        <a href="/admin" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Executive Overview
        </a>
        <a href="/admin/leads" class="px-3.5 py-2 bg-amber-400/10 text-amber-400 font-bold rounded-lg border border-amber-500/30">
          CRM &amp; Leads Kanban
        </a>
        <a href="/admin/fleet" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Fleet &amp; Drivers
        </a>
        <a href="/admin/dispatch" class="px-3.5 py-2 text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          Live Dispatch
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/" class="text-xs text-slate-400 hover:text-white">&larr; Public Site</a>
      </div>
    </header>

    <!-- Main Kanban Area -->
    <main class="flex-grow p-6 sm:p-8 max-w-[1600px] mx-auto w-full space-y-6">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="font-serif font-black text-2xl text-white">Holiday Inquiries &amp; CRM Pipeline</h1>
          <p class="text-xs text-slate-400 mt-0.5">Drag, assign and convert incoming holiday leads</p>
        </div>
      </div>

      <!-- Kanban Columns -->
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4 overflow-x-auto pb-4">
        {stages.map(stage => {
          const stageLeads = leads.filter(l => l.status === stage.id);
          return (
            <div class="rounded-2xl bg-[#0A1128] border border-slate-800 p-4 flex flex-col h-[calc(100vh-200px)] min-w-[260px]">
              <!-- Column Header -->
              <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800">
                <span class={`text-xs font-bold uppercase tracking-wider ${stage.color}`}>
                  {stage.title}
                </span>
                <span class="w-5 h-5 rounded-full bg-white/5 text-slate-300 text-[11px] font-mono flex items-center justify-center">
                  {stageLeads.length}
                </span>
              </div>

              <!-- Lead Cards inside Column -->
              <div class="flex-grow space-y-3 overflow-y-auto pr-1">
                {stageLeads.map(lead => (
                  <div class="rounded-xl p-3.5 bg-[#060B18] border border-slate-800 hover:border-amber-500/40 shadow-md transition-all cursor-pointer space-y-2">
                    <div class="flex justify-between items-start">
                      <span class="font-mono text-[10px] text-slate-400">{lead.leadCode}</span>
                      <span class="text-[10px] text-amber-400 font-bold bg-amber-500/10 px-1.5 py-0.5 rounded">
                        {lead.source}
                      </span>
                    </div>

                    <h4 class="font-serif font-bold text-sm text-white">{lead.fullName}</h4>

                    <p class="text-[11px] text-slate-300 line-clamp-1">
                      📍 {lead.destination}
                    </p>

                    <div class="flex justify-between items-center text-[10px] text-slate-400 pt-2 border-t border-slate-800/80">
                      <span>👥 {lead.travellersCount} Pax</span>
                      <span class="font-serif font-bold text-white">₹{(lead.estimatedBudget || 0).toLocaleString('en-IN')}</span>
                    </div>

                    <div class="pt-1 flex items-center justify-between text-[9px] text-slate-400">
                      <span>👤 {lead.assignedStaffName?.split(' ')[0]}</span>
                      <a href={`tel:${lead.phone}`} class="text-amber-400 hover:underline">📞 Call</a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </main>
  </body>
</html>
