---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import { mockDatabase } from '../../../../backend/src/data/mockDatabase';

export function getStaticPaths() {
  return mockDatabase.destinations.map(dest => ({
    params: { slug: dest.slug },
    props: { destination: dest }
  }));
}

const { destination } = Astro.props;
const relatedTours = mockDatabase.tours.filter(t => t.destinationSlug === destination.slug);
---

<BaseLayout
  title={`${destination.name} | Shree Chowdeshwari Travels`}
  description={destination.description}
  image={destination.heroImage}
>
  <!-- Full Bleed Destination Hero -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end pb-16 overflow-hidden bg-[#0D0D0D]">
    <img
      src={destination.heroImage}
      alt={destination.name}
      class="absolute inset-0 w-full h-full object-cover object-center opacity-90"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0D0D0D] via-black/30 to-black/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 w-full text-white space-y-4">
      <span class="text-xs uppercase tracking-[0.25em] font-medium text-[#E5DFC5] bg-black/40 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/15 inline-block">
        {destination.stateOrCountry}
      </span>
      <h1 class="font-serif font-light text-4xl sm:text-6xl lg:text-7xl text-white tracking-tight leading-[1.05]">
        {destination.name}
      </h1>
      <p class="font-editorial italic text-xl sm:text-2xl text-[#E5DFC5]">
        "{destination.tagline}"
      </p>
    </div>
  </section>

  <!-- Destination Narrative & Highlights -->
  <section class="py-20 sm:py-28 bg-[#FAF8F5] border-b border-[#E8E2D6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Overview Narrative -->
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs uppercase tracking-[0.2em] font-bold text-[#8C733E] block">
            Destination Story
          </span>
          <h2 class="font-serif font-light text-3xl sm:text-4xl text-[#171717]">
            About the Circuit
          </h2>
          <p class="text-sm sm:text-base text-[#6B7280] font-light leading-relaxed">
            {destination.description}
          </p>

          {destination.travelTips && (
            <div class="p-6 rounded-2xl bg-white border border-[#E8E2D6] shadow-subtle text-xs text-[#171717] space-y-1">
              <strong class="text-[#8C733E] uppercase tracking-wider block text-[10px]">Local Travel Advisory</strong>
              <p class="text-[#6B7280] leading-relaxed">{destination.travelTips}</p>
            </div>
          )}
        </div>

        <!-- Highlights & Season Info -->
        <div class="lg:col-span-5 p-8 rounded-3xl bg-white border border-[#E8E2D6] shadow-subtle space-y-6">
          <div class="border-b border-[#F6F2EA] pb-5">
            <span class="text-[10px] uppercase tracking-[0.2em] text-[#8C733E] font-bold block mb-1">Optimal Season</span>
            <span class="font-serif text-2xl text-[#171717]">{destination.bestTimeToVisit}</span>
          </div>

          <div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-[#8C733E] font-bold block mb-4">Curated Highlights</span>
            <ul class="space-y-3 text-xs text-[#4B5563]">
              {destination.highlights.map(h => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#B89B5E] text-sm">&bull;</span>
                  <span class="leading-relaxed font-light">{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-[#F6F2EA]">
            <a
              href="/plan-your-trip"
              class="w-full py-3.5 block text-center rounded-full bg-[#171717] text-white hover:bg-[#2E2E2E] text-xs font-semibold uppercase tracking-[0.15em] transition-all"
            >
              Plan a Custom {destination.name} Tour
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Tour Packages -->
  <section class="py-20 sm:py-28 bg-[#FAF8F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
      <div class="max-w-xl mb-14">
        <span class="text-xs uppercase tracking-[0.25em] font-bold text-[#8C733E] block mb-2">
          Available Itineraries
        </span>
        <h2 class="font-serif font-light text-3xl sm:text-4xl text-[#171717]">
          Journeys in {destination.name}
        </h2>
      </div>

      {relatedTours.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {relatedTours.map(tour => (
            <TourCard tour={tour} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 p-8 rounded-3xl bg-white border border-[#E8E2D6] max-w-lg mx-auto">
          <p class="text-sm text-[#6B7280] font-light mb-4">We curate bespoke private itineraries for this destination.</p>
          <a href="/plan-your-trip" class="px-6 py-3 rounded-full bg-[#171717] text-white text-xs font-semibold uppercase tracking-wider">
            Request Custom Itinerary
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
