---

<section class="relative min-h-[92vh] flex flex-col justify-between pt-24 sm:pt-28 pb-12 px-4 sm:px-8 lg:px-12 bg-[#070A10] text-white overflow-hidden select-none">
  <!-- Dynamic Cinematic Canvas Background (Auto Crossfades & Ken Burns) -->
  <div class="absolute inset-0 z-0">
    {destinations.map((dest, idx) => (
      <div
        class={`hero-canvas-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
        data-canvas-id={dest.id}
      >
        <img
          src={dest.image}
          alt={dest.name}
          class="w-full h-full object-cover object-center transform scale-105 transition-transform duration-[14000ms] ease-out will-change-transform opacity-35"
        />
        <!-- Cinematic Multi-Tone Radial Gradients -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#070A10] via-[#070A10]/70 to-[#070A10]/40"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#070A10] via-[#070A10]/60 to-transparent"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#3B82F6_1px,transparent_1px)] [background-size:32px_32px] opacity-10"></div>
      </div>
    ))}
  </div>

  <!-- Ambient Light Orbs -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-600/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-amber-500/15 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10 w-full my-auto py-4 space-y-8">
    <!-- Asymmetric Top Grid: Left Editorial Command, Right Interactive Holographic Pass -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Visionary Headline & Spotlight Booking Capsule (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Live Dispatch Status Capsule -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.08] border border-white/20 backdrop-blur-2xl shadow-xl">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-xs font-mono font-bold text-amber-300 uppercase tracking-wider">
            Verified Tours &amp; Travels &bull; 100% Own Fleet
          </span>
          <span class="text-white/30">|</span>
          <span class="text-xs font-mono text-emerald-400 font-bold">★ 4.95 (15,000+ Completed Trips)</span>
        </div>

        <!-- Headline with Liquid Gold/Blue Gradient -->
        <h1 class="font-extrabold text-4xl sm:text-6xl lg:text-7xl text-white tracking-tight leading-[1.05]">
          Travel Beyond<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-200 to-amber-500 font-serif italic font-normal">
            Ordinary Limits.
          </span>
        </h1>

        <p id="hero-dynamic-quote" class="text-sm sm:text-base text-slate-200 font-light max-w-xl leading-relaxed">
          {destinations[0].quote} Company-owned Innova Crysta ZX, Fortuner 4x4, and Force Urbania with certified master chauffeurs.
        </p>

        <!-- Ultra-Modern Spotlight Booking Capsule (All-in-One Glass Dock) -->
        <div class="p-2 sm:p-2.5 rounded-3xl bg-[#0F1420]/80 backdrop-blur-3xl border border-white/20 shadow-2xl space-y-2.5">
          <!-- Service Mode Switcher Tabs -->
          <div class="flex items-center gap-1.5 p-1 bg-black/50 rounded-2xl">
            <button class="svc-tab-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 shadow-md cursor-pointer" data-service="tours">
              🌴 Holiday Tours
            </button>
            <button class="svc-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white cursor-pointer" data-service="cabs">
              🚖 Outstation Cabs
            </button>
            <button class="svc-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white cursor-pointer" data-service="airport">
              ✈️ Airport Drops
            </button>
          </div>

          <!-- The Streamlined Search Console -->
          <form action="/tours" method="GET" class="grid grid-cols-1 sm:grid-cols-12 gap-2 p-2 bg-black/40 rounded-2xl border border-white/10 items-center">
            <!-- Where -->
            <div class="sm:col-span-5 px-3 py-1.5">
              <label class="block text-[10px] font-mono uppercase tracking-wider text-amber-300 font-bold mb-0.5">
                Destination Circuit
              </label>
              <select id="hero-dest-select" name="destination" class="w-full bg-transparent text-sm font-bold text-white focus:outline-none cursor-pointer">
                <option value="" class="bg-[#0F1420] text-white">Select Destination</option>
                <option value="mysore-srirangapatna" class="bg-[#0F1420] text-white" selected>👑 Mysore &amp; Royal Palaces</option>
                <option value="coorg-kodagu" class="bg-[#0F1420] text-white">☕ Coorg Coffee Highlands</option>
                <option value="ooty-nilgiris" class="bg-[#0F1420] text-white">🚂 Ooty &amp; Nilgiris Mountain Train</option>
                <option value="chikmagalur" class="bg-[#0F1420] text-white">🏔️ Chikmagalur &amp; Mullayanagiri</option>
                <option value="kerala-backwaters" class="bg-[#0F1420] text-white">🌴 Kerala Backwaters &amp; Munnar</option>
                <option value="kashmir-paradise" class="bg-[#0F1420] text-white">❄️ Kashmir Crown &amp; Gulmarg</option>
              </select>
            </div>

            <!-- Vehicle / Group -->
            <div class="sm:col-span-4 px-3 py-1.5 sm:border-l border-white/10">
              <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold mb-0.5">
                Preferred Vehicle
              </label>
              <select name="vehicle" class="w-full bg-transparent text-sm font-bold text-white focus:outline-none cursor-pointer">
                <option value="innova" class="bg-[#0F1420] text-white">Innova Crysta ZX (6+1)</option>
                <option value="urbania" class="bg-[#0F1420] text-white">Force Urbania (12+1)</option>
                <option value="fortuner" class="bg-[#0F1420] text-white">Fortuner 4x4 (6+1)</option>
                <option value="dzire" class="bg-[#0F1420] text-white">Swift Dzire (4+1)</option>
              </select>
            </div>

            <!-- Search CTA -->
            <div class="sm:col-span-3">
              <button
                type="submit"
                class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-yellow-300 hover:to-amber-400 text-slate-950 font-black uppercase tracking-wider text-xs shadow-lg shadow-amber-500/30 transition-all flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer"
              >
                <span>Explore</span>
                <span>→</span>
              </button>
            </div>
          </form>

          <!-- Micro Trust Ribbons -->
          <div class="flex flex-wrap items-center justify-between px-3 pt-1 text-[11px] text-slate-300 font-medium">
            <span class="flex items-center gap-1"><span class="text-emerald-400 font-bold">✓</span> 100% Own Fleet</span>
            <span class="flex items-center gap-1"><span class="text-emerald-400 font-bold">✓</span> 25% Token to Confirm</span>
            <span class="flex items-center gap-1"><span class="text-emerald-400 font-bold">✓</span> Zero Surge Guarantee</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Holographic Boarding Card HUD (5 Cols) -->
      <div class="lg:col-span-5">
        <div class="relative group">
          <!-- Ambient Glow Flare -->
          <div class="absolute -inset-1 bg-gradient-to-r from-amber-500/30 via-blue-500/30 to-indigo-500/20 rounded-3xl blur-2xl opacity-75 group-hover:opacity-100 transition duration-1000"></div>

          <!-- Glassmorphic VIP Boarding HUD -->
          <div class="relative rounded-3xl bg-[#0D111A]/90 backdrop-blur-3xl border border-white/20 p-6 sm:p-7 shadow-2xl text-white space-y-5">
            <!-- Top HUD Bar -->
            <div class="flex items-center justify-between pb-3 border-b border-white/10">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-gradient-to-tr from-amber-400 to-yellow-200"></span>
                <span class="text-xs font-mono font-bold uppercase tracking-widest text-amber-300">
                  Confirmed Chauffeur Pass
                </span>
              </div>
              <span id="hud-tag" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border bg-amber-500/20 text-amber-300 border-amber-500/40">
                {destinations[0].tag}
              </span>
            </div>

            <!-- Route Departure / Destination Telemetry Box -->
            <div class="grid grid-cols-3 items-center text-center p-3 rounded-2xl bg-black/40 border border-white/10">
              <div class="text-left">
                <span class="text-[9px] font-mono text-slate-400 block uppercase">ORIGIN</span>
                <span class="font-extrabold text-lg text-white">BLR</span>
                <span class="text-[10px] text-slate-300 block">Bangalore</span>
              </div>
              <div class="flex flex-col items-center justify-center">
                <span id="hud-distance" class="text-[10px] font-mono font-bold text-amber-300">145 KM</span>
                <div class="w-full flex items-center gap-1 my-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                  <span class="h-[1px] w-full bg-gradient-to-r from-amber-400 to-amber-200"></span>
                  <span class="text-amber-400 text-xs">➔</span>
                </div>
                <span class="text-[9px] font-mono text-emerald-400 font-bold">CHAUFFEUR VIP</span>
              </div>
              <div class="text-right">
                <span class="text-[9px] font-mono text-slate-400 block uppercase">DESTINATION</span>
                <span id="hud-code" class="font-extrabold text-lg text-amber-300">MYS</span>
                <span id="hud-name-short" class="text-[10px] text-slate-300 block">Mysore Palace</span>
              </div>
            </div>

            <!-- Assigned Fleet & Perks -->
            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between py-1 border-b border-white/5">
                <span class="text-slate-400">Assigned Fleet:</span>
                <span id="hud-car" class="font-bold text-white">{destinations[0].car}</span>
              </div>
              <div class="flex items-center justify-between py-1 border-b border-white/5">
                <span class="text-slate-400">Live Weather:</span>
                <span id="hud-weather" class="font-mono text-amber-300">{destinations[0].weather}</span>
              </div>
              <div class="flex items-center justify-between py-1 border-b border-white/5">
                <span class="text-slate-400">Advance Commitment:</span>
                <span id="hud-advance" class="font-mono font-bold text-emerald-400">{destinations[0].advance}</span>
              </div>
            </div>

            <!-- Action CTA -->
            <div class="pt-2">
              <a
                href="/plan-your-trip"
                class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 hover:from-yellow-300 hover:to-amber-400 text-slate-950 font-black text-xs uppercase tracking-[0.2em] flex items-center justify-center gap-2 shadow-xl hover:scale-102 active:scale-95 transition-all"
              >
                <span>Reserve with 25% Token</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Interactive Destination Pill Selector (The Creative Switcher) -->
    <div class="pt-4 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <span class="text-xs font-mono uppercase tracking-widest text-slate-400">
        Choose Destination World:
      </span>

      <div class="flex flex-wrap items-center gap-2">
        {destinations.map((dest, idx) => (
          <button
            class={`dest-world-btn px-4 py-2 rounded-full border text-xs font-bold transition-all cursor-pointer ${idx === 0 ? 'bg-gradient-to-r from-amber-400 to-yellow-300 text-slate-950 border-transparent shadow-lg shadow-amber-500/20' : 'bg-white/5 border-white/15 text-slate-300 hover:text-white hover:border-amber-400/50'}`}
            data-target-id={dest.id}
          >
            {dest.name.split(" ")[0]} {dest.name.split(" ")[1]} ({dest.fare})
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Interactive Destination Switcher Script -->
<script define:vars={{ destinations }}>
  let currentIndex = 0;
  const slides = document.querySelectorAll('.hero-canvas-slide');
  const buttons = document.querySelectorAll('.dest-world-btn');
  const quoteEl = document.getElementById('hero-dynamic-quote');
  const tagEl = document.getElementById('hud-tag');
  const distEl = document.getElementById('hud-distance');
  const codeEl = document.getElementById('hud-code');
  const nameShortEl = document.getElementById('hud-name-short');
  const carEl = document.getElementById('hud-car');
  const weatherEl = document.getElementById('hud-weather');
  const advanceEl = document.getElementById('hud-advance');
  const destSelect = document.getElementById('hero-dest-select');

  const destCodes = {
    mysore: "MYS",
    coorg: "CRG",
    kerala: "COK",
    kashmir: "SXR",
    tirupati: "TPT"
  };

  const destSlugs = {
    mysore: "mysore-srirangapatna",
    coorg: "coorg-kodagu",
    kerala: "kerala-backwaters",
    kashmir: "kashmir-paradise",
    tirupati: "mysore-srirangapatna"
  };

  function switchDestination(targetId) {
    const dest = destinations.find(d => d.id === targetId);
    if (!dest) return;

    // Crossfade canvas slides
    slides.forEach(slide => {
      if (slide.dataset.canvasId === targetId) {
        slide.classList.remove('opacity-0', 'pointer-events-none');
        slide.classList.add('opacity-100');
      } else {
        slide.classList.remove('opacity-100');
        slide.classList.add('opacity-0', 'pointer-events-none');
      }
    });

    // Update buttons
    buttons.forEach(btn => {
      if (btn.dataset.targetId === targetId) {
        btn.className = 'dest-world-btn px-4 py-2 rounded-full border text-xs font-bold transition-all cursor-pointer bg-gradient-to-r from-amber-400 to-yellow-300 text-slate-950 border-transparent shadow-lg shadow-amber-500/20';
      } else {
        btn.className = 'dest-world-btn px-4 py-2 rounded-full border text-xs font-bold transition-all cursor-pointer bg-white/5 border-white/15 text-slate-300 hover:text-white hover:border-amber-400/50';
      }
    });

    // Update HUD texts
    if (quoteEl) quoteEl.innerHTML = `${dest.quote} Company-owned Innova Crysta ZX, Fortuner 4x4, and Force Urbania with certified master chauffeurs.`;
    if (tagEl) {
      tagEl.textContent = dest.tag;
      tagEl.className = `px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border ${dest.tagColor}`;
    }
    if (distEl) distEl.textContent = dest.distance.split("&bull;")[0].trim();
    if (codeEl) codeEl.textContent = destCodes[targetId] || "MYS";
    if (nameShortEl) nameShortEl.textContent = dest.name.split("&")[0].trim();
    if (carEl) carEl.textContent = dest.car;
    if (weatherEl) weatherEl.textContent = dest.weather;
    if (advanceEl) advanceEl.textContent = dest.advance;

    if (destSelect) {
      destSelect.value = destSlugs[targetId] || "";
    }
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      switchDestination(btn.dataset.targetId);
    });
  });

  // Auto transition every 8 seconds if user is idle
  let autoCycle = setInterval(() => {
    currentIndex = (currentIndex + 1) % destinations.length;
    switchDestination(destinations[currentIndex].id);
  }, 8000);

  // Pause on hover
  const section = document.querySelector('section');
  if (section) {
    section.addEventListener('mouseenter', () => clearInterval(autoCycle));
    section.addEventListener('mouseleave', () => {
      clearInterval(autoCycle);
      autoCycle = setInterval(() => {
        currentIndex = (currentIndex + 1) % destinations.length;
        switchDestination(destinations[currentIndex].id);
      }, 8000);
    });
  }
</script>
