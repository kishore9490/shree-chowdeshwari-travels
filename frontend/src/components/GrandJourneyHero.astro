---
// Grand Luxury Journey Hero Component with Interactive Dimension Switcher
const heroDestinations = [
  {
    id: "mysore",
    name: "ROYAL MYSORE & PALACE HERITAGE",
    subtitle: "The Splendor of Southern Royalty & 97,000 Golden Lights",
    badge: "SIGNATURE ROYAL CIRCUIT",
    location: "Karnataka &bull; 12.3052° N, 76.6552° E",
    elevation: "770 m &bull; Royal Plains",
    temp: "24°C &bull; Golden Twilight",
    distance: "145 km from Bangalore (3h Chauffeur Drive)",
    image: "https://images.unsplash.com/photo-1590050752117-238cb0fb12b1?auto=format&fit=crop&w=2400&q=90",
    vehicle: "Toyota Innova Crysta ZX (Captain Class)",
    highlights: ["VIP Private Palace Access", "Srirangapatna Summer Citadel", "Chamundi Hill Sunset Chauffeur"],
    themeColor: "from-amber-500/30 to-yellow-600/10",
    goldAccent: "#D4AF37",
    ambientMode: "mysore"
  },
  {
    id: "coorg",
    name: "COORG HIGHLANDS & MISTY RIDGES",
    subtitle: "Private Arabica Estates, Waterfalls & 4x4 Cloud Safaris",
    badge: "MISTY HIGHLAND RETREAT",
    location: "Kodagu &bull; 12.4244° N, 75.7382° E",
    elevation: "1,340 m &bull; Western Ghats",
    temp: "19°C &bull; Misty Morning",
    distance: "260 km from Bangalore (5.5h Scenic Cruise)",
    image: "https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=2400&q=90",
    vehicle: "Toyota Fortuner 4x4 (Highland Edition)",
    highlights: ["Mandalpatti Open-Jeep Safari", "Private Estate Coffee Tasting", "Abbey Falls Chauffeur Excursion"],
    themeColor: "from-emerald-500/30 to-teal-700/10",
    goldAccent: "#4ADE80",
    ambientMode: "coorg"
  },
  {
    id: "kerala",
    name: "KERALA BACKWATERS & MUNNAR TEA",
    subtitle: "Private Luxury Houseboats, Emerald Lagoons & Kathakali",
    badge: "COASTAL & HILL SANCTUARY",
    location: "Alleppey &bull; 9.4981° N, 76.3388° E",
    elevation: "Sea Level to 1,600 m",
    temp: "26°C &bull; Tropical Breeze",
    distance: "580 km from Bangalore (Private Flight/Chauffeur)",
    image: "https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=2400&q=90",
    vehicle: "Force Urbania Executive (Maharaja Lounge)",
    highlights: ["Private AC Houseboat with Chef", "Munnar Tea Plantation Walk", "Kathakali Evening VIP Front Row"],
    themeColor: "from-cyan-500/30 to-blue-700/10",
    goldAccent: "#38BDF8",
    ambientMode: "kerala"
  },
  {
    id: "kashmir",
    name: "KASHMIR CROWN & GULMARG SNOW",
    subtitle: "Cedarwood Houseboats, Dal Lake Shikaras & Alpine Gondola",
    badge: "HIMALAYAN SNOW EXPEDITION",
    location: "Srinagar &bull; 34.0837° N, 74.7973° E",
    elevation: "2,650 m &bull; Pir Panjal Range",
    temp: "4°C &bull; Crisp Alpine Snow",
    distance: "Flight to SXR + Dedicated Chauffeur Fleet",
    image: "https://images.unsplash.com/photo-1595815771614-ade9d652a65d?auto=format&fit=crop&w=2400&q=90",
    vehicle: "Toyota Fortuner 4x4 Snow King",
    highlights: ["Gulmarg Gondola Phase 2 Access", "Private Cedarwood Dal Lake Stay", "Pahalgam Betaab Valley Safari"],
    themeColor: "from-sky-400/30 to-indigo-700/10",
    goldAccent: "#93C5FD",
    ambientMode: "kashmir"
  },
  {
    id: "temple",
    name: "SACRED SOUTHERN DIVINE TRAILS",
    subtitle: "Tirupati VIP Darshan, Rameshwaram & Madurai Meenakshi",
    badge: "DIVINE PILGRIMAGE CIRCUIT",
    location: "Tamil Nadu / AP &bull; 13.6833° N, 79.3500° E",
    elevation: "850 m &bull; Sacred Hills",
    temp: "28°C &bull; Auspicious Twilight",
    distance: "250 km from Bangalore (Smooth 4.5h Highway)",
    image: "https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=2400&q=90",
    vehicle: "Force Urbania Executive (Family Pilgrim Cruiser)",
    highlights: ["Special Entry Darshan Coordination", "Senior-Citizen Friendly Chauffeur Care", "Temple Town Heritage Guidance"],
    themeColor: "from-amber-600/30 to-rose-700/10",
    goldAccent: "#F59E0B",
    ambientMode: "temple"
  }
];
---

<section class="relative min-h-[95vh] flex flex-col justify-between pt-28 sm:pt-36 pb-12 px-4 sm:px-8 lg:px-12 bg-[#0A0A0A] overflow-hidden text-white select-none">
  <!-- Dynamic Background Slides with Ken Burns Crossfade -->
  <div class="absolute inset-0 z-0">
    {heroDestinations.map((dest, idx) => (
      <div
        class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
        data-slide-id={dest.id}
      >
        <img
          src={dest.image}
          alt={dest.name}
          class="w-full h-full object-cover object-center transform scale-105 transition-transform duration-[12000ms] ease-out will-change-transform"
        />
        <!-- Atmospheric Cinema Gradients -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-black/40 to-black/60"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/40 to-transparent"></div>
        <!-- Subtle Animated Particle Overlay -->
        <div class="absolute inset-0 bg-[radial-gradient(#D4AF37_1px,transparent_1px)] [background-size:32px_32px] opacity-15"></div>
      </div>
    ))}
  </div>

  <!-- Top Live Telemetry Radar & Status Dock -->
  <div class="relative z-10 max-w-7xl mx-auto w-full flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs font-mono">
    <!-- Live Coordinates & Altitude -->
    <div class="flex items-center gap-3 bg-black/60 backdrop-blur-xl px-4 py-2 rounded-full border border-white/15 shadow-2xl">
      <span class="w-2.5 h-2.5 rounded-full bg-[#D4AF37] animate-ping"></span>
      <span id="hero-live-location" class="text-white/90">
        Karnataka &bull; 12.3052° N, 76.6552° E
      </span>
      <span class="text-white/30">|</span>
      <span id="hero-live-elevation" class="text-[#F3E5AB]">
        770 m &bull; Royal Plains
      </span>
    </div>

    <!-- Right Telemetry: Fleet Status & Ambient Sound Player -->
    <div class="flex items-center gap-3">
      <!-- Ambient Sound Toggle -->
      <button
        id="ambient-sound-btn"
        class="flex items-center gap-2.5 bg-black/60 hover:bg-black/80 backdrop-blur-xl px-4 py-2 rounded-full border border-amber-500/30 text-white/80 hover:text-white transition-all cursor-pointer group"
        title="Experience Ambient Journey Audio"
      >
        <div class="flex items-end gap-0.5 h-3.5 w-4" id="audio-wave-bars">
          <span class="w-0.5 h-1.5 bg-[#D4AF37] rounded-full group-hover:h-3 transition-all"></span>
          <span class="w-0.5 h-3 bg-[#D4AF37] rounded-full group-hover:h-3.5 transition-all"></span>
          <span class="w-0.5 h-2 bg-[#D4AF37] rounded-full group-hover:h-2.5 transition-all"></span>
          <span class="w-0.5 h-3.5 bg-[#D4AF37] rounded-full group-hover:h-1.5 transition-all"></span>
        </div>
        <span id="ambient-sound-text" class="text-[11px] font-sans font-medium text-[#F3E5AB]">
          Ambiance: Mysore Palace
        </span>
      </button>

      <!-- Fleet Readiness Indicator -->
      <div class="hidden md:flex items-center gap-2 bg-emerald-950/60 backdrop-blur-xl px-3.5 py-2 rounded-full border border-emerald-500/30 text-emerald-300 text-[11px]">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>100% Own Fleet Ready &bull; Bangalore HQ</span>
      </div>
    </div>
  </div>

  <!-- Center Main Showcase Grid: Editorial Text on Left, Floating VIP Boarding Pass on Right -->
  <div class="relative z-10 max-w-7xl mx-auto w-full my-auto py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Editorial Display Title & Copy -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-black/50 backdrop-blur-md border border-amber-400/40">
          <span class="text-amber-400 font-serif">✦</span>
          <span id="hero-badge-tag" class="text-[10px] uppercase tracking-[0.25em] font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#F3E5AB] via-[#D4AF37] to-[#AA771C]">
            SIGNATURE ROYAL CIRCUIT
          </span>
        </div>

        <!-- Grand Display Heading -->
        <h1 class="font-serif font-light text-4xl sm:text-6xl lg:text-7xl xl:text-8xl text-white tracking-tight leading-[0.95] drop-shadow-2xl">
          THE ART OF<br />
          <span class="font-editorial italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#F3E5AB] via-[#D4AF37] to-[#E5DFC5]">EFFORTLESS</span><br />
          JOURNEYS.
        </h1>

        <!-- Subtitle & Distance Copy -->
        <p id="hero-subtitle-text" class="max-w-xl text-base sm:text-lg text-white/90 font-light leading-relaxed">
          The Splendor of Southern Royalty &amp; 97,000 Golden Lights. Travel in company-owned Innova Crysta ZX with master verified chauffeurs.
        </p>

        <!-- Highlights Badges -->
        <div id="hero-highlights-container" class="flex flex-wrap gap-2.5 pt-2">
          {heroDestinations[0].highlights.map((item) => (
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs text-white/90 font-light">
              <span class="text-[#D4AF37]">✓</span> {item}
            </span>
          ))}
        </div>

        <!-- Primary Actions -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="/tours"
            class="px-8 py-4 rounded-full bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#AA771C] text-[#121212] font-black text-xs uppercase tracking-[0.18em] transition-all duration-300 transform hover:scale-105 active:scale-98 shadow-xl shadow-amber-500/20"
          >
            Explore All 20+ Journeys
          </a>
          <a
            href="#journey-architect"
            class="px-8 py-4 rounded-full bg-black/60 hover:bg-black/90 backdrop-blur-md border border-white/30 text-white text-xs font-semibold uppercase tracking-[0.18em] transition-all duration-300"
          >
            Instant Cost Simulator ↓
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Holographic VIP Boarding Card -->
      <div class="lg:col-span-5">
        <div class="relative group">
          <!-- Ambient Golden Glow behind Card -->
          <div class="absolute -inset-1 bg-gradient-to-r from-amber-500/40 via-yellow-600/30 to-amber-700/20 rounded-3xl blur-xl opacity-75 group-hover:opacity-100 transition duration-1000"></div>

          <!-- Glassmorphic VIP Boarding Card -->
          <div class="relative rounded-3xl bg-gradient-to-b from-[#1A1A1A]/95 via-[#121212]/95 to-[#0D0D0D]/95 backdrop-blur-2xl border border-amber-500/40 p-6 sm:p-8 text-white shadow-2xl space-y-6">
            <!-- Card Header: Gold Emblem & Ticket Title -->
            <div class="flex justify-between items-start pb-4 border-b border-white/10">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-[#D4AF37] to-[#8C733E] flex items-center justify-center font-serif text-lg font-bold text-black shadow-md">
                  SC
                </div>
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-[#D4AF37] block">VIP Travel Pass</span>
                  <span class="font-serif text-base text-white font-medium">Shree Chowdeshwari</span>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-md bg-amber-500/20 text-amber-300 text-[10px] font-mono font-bold tracking-wider">
                CONFIRMED FLEET
              </span>
            </div>

            <!-- Route Departure & Destination Visualizer -->
            <div class="grid grid-cols-3 items-center text-center gap-2 py-2 bg-black/40 rounded-2xl p-4 border border-white/5">
              <div class="text-left">
                <span class="text-[10px] font-mono text-white/50 block">DEPARTURE</span>
                <span class="font-serif text-xl sm:text-2xl font-bold text-white">BLR</span>
                <span class="text-[10px] text-white/70 block">Bangalore Doorstep</span>
              </div>
              <div class="flex flex-col items-center justify-center px-1">
                <span id="card-route-distance" class="text-[9px] font-mono text-[#F3E5AB] font-bold">145 KM</span>
                <div class="w-full flex items-center gap-1 my-1">
                  <span class="w-2 h-2 rounded-full bg-[#D4AF37]"></span>
                  <span class="h-[1px] w-full bg-gradient-to-r from-[#D4AF37] to-amber-300"></span>
                  <span class="text-amber-400 text-xs">➔</span>
                </div>
                <span class="text-[9px] font-mono text-emerald-400">CHAUFFEUR VIP</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-mono text-white/50 block">DESTINATION</span>
                <span id="card-dest-code" class="font-serif text-xl sm:text-2xl font-bold text-[#F3E5AB]">MYS</span>
                <span id="card-dest-name" class="text-[10px] text-white/70 block">Mysore Palace</span>
              </div>
            </div>

            <!-- Vehicle & Chauffeur Assignment Details -->
            <div class="space-y-2.5 text-xs">
              <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                <span class="text-white/50 font-light">Assigned Vehicle:</span>
                <span id="card-vehicle" class="font-semibold text-white">Innova Crysta ZX (Captain Class)</span>
              </div>
              <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                <span class="text-white/50 font-light">Live Conditions:</span>
                <span id="card-temp" class="text-amber-300 font-mono">24°C &bull; Golden Twilight</span>
              </div>
              <div class="flex justify-between items-center py-1.5 border-b border-white/5">
                <span class="text-white/50 font-light">Advance Commitment:</span>
                <span class="text-emerald-400 font-mono font-bold">Only 25% Token to Reserve</span>
              </div>
            </div>

            <!-- Card Bottom Action -->
            <div class="pt-2">
              <a
                href="/plan-your-trip"
                class="w-full py-3.5 rounded-xl bg-gradient-to-r from-[#D4AF37] to-[#AA771C] hover:from-[#F3E5AB] hover:to-[#D4AF37] text-black font-black text-xs uppercase tracking-[0.2em] flex items-center justify-center gap-2 transition-all shadow-lg active:scale-98"
              >
                <span>Book This Journey</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Dimension Selector Pills (Interactive Journey Tabs) -->
  <div class="relative z-10 max-w-7xl mx-auto w-full pt-4 pb-2">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <span class="text-[11px] uppercase tracking-[0.2em] font-mono text-white/60">
        Choose Journey Experience:
      </span>

      <!-- Interactive Switcher Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        {heroDestinations.map((dest, idx) => (
          <button
            class={`hero-nav-pill px-4 py-2 rounded-full text-xs font-medium transition-all duration-300 cursor-pointer border ${idx === 0 ? 'bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#AA771C] text-black font-bold border-transparent shadow-lg' : 'bg-black/60 text-white/80 border-white/15 hover:border-amber-400/50 hover:text-white'}`}
            data-target-dest={dest.id}
          >
            {dest.name.split(" & ")[0]}
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Client Side Script for Real-time Dimension Switching & Subtle Audio Synthesis Ambiance -->
<script define:vars={{ heroDestinations }}>
  let currentIndex = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const pills = document.querySelectorAll('.hero-nav-pill');
  const locationEl = document.getElementById('hero-live-location');
  const elevationEl = document.getElementById('hero-live-elevation');
  const badgeTagEl = document.getElementById('hero-badge-tag');
  const subtitleEl = document.getElementById('hero-subtitle-text');
  const highlightsEl = document.getElementById('hero-highlights-container');
  const cardDistanceEl = document.getElementById('card-route-distance');
  const cardDestCodeEl = document.getElementById('card-dest-code');
  const cardDestNameEl = document.getElementById('card-dest-name');
  const cardVehicleEl = document.getElementById('card-vehicle');
  const cardTempEl = document.getElementById('card-temp');
  const soundBtn = document.getElementById('ambient-sound-btn');
  const soundText = document.getElementById('ambient-sound-text');
  const waveBars = document.getElementById('audio-wave-bars');

  const destCodes = {
    mysore: "MYS",
    coorg: "CRG",
    kerala: "COK",
    kashmir: "SXR",
    temple: "TPT"
  };

  const destShortNames = {
    mysore: "Mysore Palace",
    coorg: "Coorg Highlands",
    kerala: "Alleppey Waters",
    kashmir: "Gulmarg Snow",
    temple: "Tirupati Shrine"
  };

  function switchDimension(index) {
    currentIndex = index;
    const dest = heroDestinations[index];
    if (!dest) return;

    // Update slides crossfade
    slides.forEach((slide) => {
      if (slide.dataset.slideId === dest.id) {
        slide.classList.remove('opacity-0', 'pointer-events-none');
        slide.classList.add('opacity-100');
      } else {
        slide.classList.remove('opacity-100');
        slide.classList.add('opacity-0', 'pointer-events-none');
      }
    });

    // Update Pills
    pills.forEach((pill) => {
      if (pill.dataset.targetDest === dest.id) {
        pill.className = 'hero-nav-pill px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 cursor-pointer border bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#AA771C] text-black border-transparent shadow-lg';
      } else {
        pill.className = 'hero-nav-pill px-4 py-2 rounded-full text-xs font-medium transition-all duration-300 cursor-pointer border bg-black/60 text-white/80 border-white/15 hover:border-amber-400/50 hover:text-white';
      }
    });

    // Update Dynamic Texts
    if (locationEl) locationEl.innerHTML = dest.location;
    if (elevationEl) elevationEl.innerHTML = dest.elevation;
    if (badgeTagEl) badgeTagEl.textContent = dest.badge;
    if (subtitleEl) subtitleEl.textContent = dest.subtitle;
    if (cardDistanceEl) cardDistanceEl.textContent = dest.distance.split(" ")[0] + " " + dest.distance.split(" ")[1];
    if (cardDestCodeEl) cardDestCodeEl.textContent = destCodes[dest.id] || "MYS";
    if (cardDestNameEl) cardDestNameEl.textContent = destShortNames[dest.id] || dest.name;
    if (cardVehicleEl) cardVehicleEl.textContent = dest.vehicle;
    if (cardTempEl) cardTempEl.innerHTML = dest.temp;

    // Update Highlights
    if (highlightsEl) {
      highlightsEl.innerHTML = dest.highlights.map(h => `
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs text-white/90 font-light">
          <span class="text-[#D4AF37]">✓</span> ${h}
        </span>
      `).join('');
    }

    if (soundText) {
      soundText.textContent = `Ambiance: ${destShortNames[dest.id]}`;
    }
  }

  pills.forEach((pill, idx) => {
    pill.addEventListener('click', () => {
      switchDimension(idx);
    });
  });

  // Ambient sound synthesizer toggle (Web Audio API subtle harmonic chords)
  let audioCtx = null;
  let isPlayingAudio = false;
  let oscillator = null;
  let gainNode = null;

  if (soundBtn) {
    soundBtn.addEventListener('click', () => {
      if (!isPlayingAudio) {
        try {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          oscillator = audioCtx.createOscillator();
          gainNode = audioCtx.createGain();
          
          oscillator.type = 'sine';
          oscillator.frequency.setValueAtTime(216, audioCtx.currentTime); // 216Hz soothing Solfeggio undertone
          gainNode.gain.setValueAtTime(0.03, audioCtx.currentTime); // Very gentle whisper volume
          
          oscillator.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          oscillator.start();
          isPlayingAudio = true;
          
          if (waveBars) {
            waveBars.classList.add('animate-pulse');
          }
          if (soundText) {
            soundText.textContent = `Playing: ${destShortNames[heroDestinations[currentIndex].id]}`;
          }
        } catch (e) {
          console.log("Audio not allowed yet", e);
        }
      } else {
        if (oscillator) {
          oscillator.stop();
          oscillator.disconnect();
        }
        isPlayingAudio = false;
        if (waveBars) {
          waveBars.classList.remove('animate-pulse');
        }
        if (soundText) {
          soundText.textContent = `Ambiance: ${destShortNames[heroDestinations[currentIndex].id]}`;
        }
      }
    });
  }

  // Auto transition every 8 seconds if idle
  let autoTimer = setInterval(() => {
    let nextIdx = (currentIndex + 1) % heroDestinations.length;
    switchDimension(nextIdx);
  }, 8000);

  // Pause on hover
  const heroSection = document.querySelector('section');
  if (heroSection) {
    heroSection.addEventListener('mouseenter', () => clearInterval(autoTimer));
    heroSection.addEventListener('mouseleave', () => {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => {
        let nextIdx = (currentIndex + 1) % heroDestinations.length;
        switchDimension(nextIdx);
      }, 8000);
    });
  }
</script>
