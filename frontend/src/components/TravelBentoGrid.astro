---
// Ultra-Modern 2026 Bento Grid Showcase for Shree Chowdeshwari Tours & Travels
---

<section class="py-16 sm:py-24 bg-[#0A0D14] text-white relative border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 space-y-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-blue-400 font-bold">
          <span>✦</span> Engineered for Effortless Travel
        </div>
        <h2 class="font-extrabold text-3xl sm:text-5xl text-white tracking-tight">
          The Chowdeshwari Standard
        </h2>
        <p class="text-sm text-slate-400 max-w-xl">
          Everything you need for seamless holidays, corporate outstation travel, and family pilgrimages across India.
        </p>
      </div>

      <a
        href="/plan-your-trip"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-white/[0.08] hover:bg-white/[0.15] border border-white/20 text-white text-xs font-bold uppercase tracking-wider transition-all"
      >
        <span>Plan Your Journey</span>
        <span>→</span>
      </a>
    </div>

    <!-- 2026 Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <!-- Bento Box 1: 100% Company-Owned Luxury Fleet (8 Cols, Large Feature) -->
      <div class="md:col-span-8 rounded-3xl bg-gradient-to-br from-[#131926] to-[#0D111A] border border-white/15 p-6 sm:p-10 relative overflow-hidden group shadow-2xl flex flex-col justify-between space-y-6">
        <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="space-y-3 relative z-10 max-w-lg">
          <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-[10px] font-mono font-bold uppercase tracking-wider border border-blue-500/30">
            100% OWNED &bull; ZERO BROKERS
          </span>
          <h3 class="font-bold text-2xl sm:text-3xl text-white">
            Command Your Chariot
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed font-normal">
            Every Toyota Innova Crysta ZX, Fortuner 4x4, and Force Urbania in our fleet is company-owned and maintained to pristine showroom conditions.
          </p>
        </div>

        <!-- Interactive Fleet Showcase inside Bento -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 relative z-10 pt-4">
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-400 transition-all space-y-2">
            <span class="text-lg">🚗</span>
            <h4 class="font-bold text-sm text-white">Innova Crysta ZX</h4>
            <p class="text-[11px] text-slate-400">6+1 Executive Captain Recliners &bull; ₹18/km</p>
          </div>

          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-400 transition-all space-y-2">
            <span class="text-lg">🚐</span>
            <h4 class="font-bold text-sm text-white">Force Urbania</h4>
            <p class="text-[11px] text-slate-400">12+1 Maharaja Jet-Lounge &bull; ₹28/km</p>
          </div>

          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-400 transition-all space-y-2">
            <span class="text-lg">🏔️</span>
            <h4 class="font-bold text-sm text-white">Fortuner 4x4</h4>
            <p class="text-[11px] text-slate-400">Mountain All-Terrain SUV &bull; ₹24/km</p>
          </div>
        </div>
      </div>

      <!-- Bento Box 2: 25% Token Confirmation (4 Cols) -->
      <div class="md:col-span-4 rounded-3xl bg-gradient-to-br from-[#1A1F2C] to-[#121622] border border-white/15 p-6 sm:p-8 relative overflow-hidden shadow-2xl flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] font-mono font-bold uppercase tracking-wider border border-emerald-500/30">
            TRANSPARENT PRICING
          </span>
          <h3 class="font-bold text-2xl text-white">
            Pay Only 25% Advance
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Lock in peak holiday dates and confirmed company vehicles with a low 25% token. Pay the rest comfortably when your trip commences.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-emerald-950/40 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-semibold space-y-1">
          <div>✓ All Interstate Permits Included</div>
          <div>✓ Driver Allowance &amp; Tolls Covered</div>
          <div>✓ Zero Hidden Fuel Surcharges</div>
        </div>
      </div>

      <!-- Bento Box 3: Master Chauffeur Care (4 Cols) -->
      <div class="md:col-span-4 rounded-3xl bg-gradient-to-br from-[#1A1F2C] to-[#121622] border border-white/15 p-6 sm:p-8 shadow-2xl flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center text-lg font-bold border border-amber-500/30">
            👨‍✈️
          </div>
          <h3 class="font-bold text-xl text-white">
            Police-Verified Chauffeurs
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Full-time master drivers with 10+ years of outstation mastery, fluent in Kannada, English &amp; Hindi with zero compromise on road safety.
          </p>
        </div>
        <span class="text-[11px] font-mono text-amber-400 font-bold">100% Background Checked &bull; Punctual</span>
      </div>

      <!-- Bento Box 4: 24/7 Operations Radar (4 Cols) -->
      <div class="md:col-span-4 rounded-3xl bg-gradient-to-br from-[#1A1F2C] to-[#121622] border border-white/15 p-6 sm:p-8 shadow-2xl flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-300 flex items-center justify-center text-lg font-bold border border-blue-500/30">
            📡
          </div>
          <h3 class="font-bold text-xl text-white">
            24/7 Live Operations Desk
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Our Bangalore command center tracks flight delays, highway route conditions, and supports you throughout your journey.
          </p>
        </div>
        <span class="text-[11px] font-mono text-blue-400 font-bold">Live GPS Telemetry &bull; Instant Support</span>
      </div>

      <!-- Bento Box 5: Custom Itinerary Architecture (4 Cols) -->
      <div class="md:col-span-4 rounded-3xl bg-gradient-to-br from-blue-900/40 via-indigo-900/30 to-[#0A0D14] border border-blue-500/30 p-6 sm:p-8 shadow-2xl flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <span class="text-2xl">🗺️</span>
          <h3 class="font-bold text-xl text-white">
            Custom Multi-City Tours
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Craft your own multi-day holiday across Mysore, Coorg, Ooty, Wayanad &amp; Hampi with customized hotel categories.
          </p>
        </div>
        <a href="/plan-your-trip" class="text-xs font-bold text-amber-300 hover:text-white transition-colors flex items-center gap-1">
          <span>Launch Trip Architect</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</section>
