---
// Minimal Luxury Brand Footer
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#171717] text-[#FAF8F5] pt-20 pb-12 border-t border-[#2E2E2E]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Top Row: Big Brand Identity & Tagline -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end pb-16 border-b border-white/10 gap-8">
      <div class="max-w-xl space-y-3">
        <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-[#D4C39E] block">
          Karnataka's Bespoke Travel Architect &bull; Est. 2011
        </span>
        <h3 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-white font-normal tracking-tight">
          SHREE CHOWDESHWARI
        </h3>
        <p class="font-editorial italic text-lg sm:text-xl text-white/70">
          "Your Journey. Our Priority."
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <a
          href="/plan-your-trip"
          class="px-7 py-3.5 rounded-full bg-white text-[#171717] hover:bg-[#F6F2EA] text-xs font-semibold uppercase tracking-[0.15em] transition-all duration-300"
        >
          Plan a Journey
        </a>
        <a
          href="https://wa.me/919845012345"
          target="_blank"
          rel="noopener"
          class="px-7 py-3.5 rounded-full border border-white/20 hover:border-white text-white text-xs font-semibold uppercase tracking-[0.15em] transition-all duration-300 flex items-center gap-2"
        >
          <span>WhatsApp Concierge</span>
        </a>
      </div>
    </div>

    <!-- Middle Row: Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 py-16 text-xs border-b border-white/10">
      <!-- Col 1: Journeys -->
      <div class="space-y-3">
        <span class="font-serif text-sm text-white block">Curated Journeys</span>
        <ul class="space-y-2 text-white/60 font-light">
          <li><a href="/tours/royal-mysore-coorg-coffee-hills-odyssey" class="hover:text-white transition-colors">Mysore &amp; Coorg Odyssey</a></li>
          <li><a href="/tours/misty-ooty-coonoor-nilgiri-mountain-express" class="hover:text-white transition-colors">Ooty &amp; Nilgiris Heritage</a></li>
          <li><a href="/tours/gods-own-kerala-munnar-alleppey-houseboat" class="hover:text-white transition-colors">Kerala Backwaters &amp; Munnar</a></li>
          <li><a href="/tours/kashmir-crown-dal-lake-gulmarg-pahalgam" class="hover:text-white transition-colors">Kashmir Crown Luxury</a></li>
          <li><a href="/tours/glorious-hampi-badami-cave-temples-trail" class="hover:text-white transition-colors">Hampi UNESCO Heritage</a></li>
          <li><a href="/tours/dubai-abu-dhabi-royal-arabian-wonders" class="hover:text-white transition-colors">Dubai Royal Wonders</a></li>
        </ul>
      </div>

      <!-- Col 2: Destinations -->
      <div class="space-y-3">
        <span class="font-serif text-sm text-white block">Destinations</span>
        <ul class="space-y-2 text-white/60 font-light">
          <li><a href="/destinations/mysore-srirangapatna" class="hover:text-white transition-colors">Mysore Palaces</a></li>
          <li><a href="/destinations/coorg-kodagu" class="hover:text-white transition-colors">Coorg Coffee Hills</a></li>
          <li><a href="/destinations/ooty-nilgiris" class="hover:text-white transition-colors">Nilgiris Mountain Rail</a></li>
          <li><a href="/destinations/chikmagalur" class="hover:text-white transition-colors">Chikmagalur Peaks</a></li>
          <li><a href="/destinations/hampi-badami" class="hover:text-white transition-colors">Hampi &amp; Badami</a></li>
          <li><a href="/destinations/kerala-backwaters" class="hover:text-white transition-colors">Alleppey &amp; Munnar</a></li>
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div class="space-y-3">
        <span class="font-serif text-sm text-white block">The Company</span>
        <ul class="space-y-2 text-white/60 font-light">
          <li><a href="/about" class="hover:text-white transition-colors">Our Heritage</a></li>
          <li><a href="/fleet" class="hover:text-white transition-colors">Private Fleet &amp; Chauffeurs</a></li>
          <li><a href="/my-account" class="hover:text-white transition-colors">Customer Portal</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Bangalore &amp; Mysore Desks</a></li>
          <li><a href="/admin" class="hover:text-white transition-colors">Operations Login</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Desk -->
      <div class="space-y-3">
        <span class="font-serif text-sm text-white block">Bangalore Concierge</span>
        <p class="text-white/60 font-light leading-relaxed">
          #142, Chowdeshwari Complex, Dr. Rajkumar Road, Rajajinagar, Bangalore - 560010
        </p>
        <p class="text-white font-medium">
          <a href="tel:+919845012345" class="hover:text-[#D4C39E]">+91 98450 12345</a>
        </p>
        <p class="text-white/60">
          <a href="mailto:concierge@shreechowdeshwari.com" class="hover:text-white">concierge@shreechowdeshwari.com</a>
        </p>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] text-white/40 font-light">
      <p>
        &copy; {currentYear} Shree Chowdeshwari Tours and Travels. Govt. of Karnataka Tourism Recognized.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Journey</a>
        <a href="/sitemap" class="hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
