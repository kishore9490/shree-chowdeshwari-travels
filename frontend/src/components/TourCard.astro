---
import type { ITour } from '../../../shared/types';

interface Props {
  tour: ITour;
}

const { tour } = Astro.props;

const formattedPrice = new Intl.NumberFormat('en-IN', {
  style: 'currency',
  currency: 'INR',
  maximumFractionDigits: 0
}).format(tour.startingPrice);

const tokenPrice = new Intl.NumberFormat('en-IN', {
  style: 'currency',
  currency: 'INR',
  maximumFractionDigits: 0
}).format(Math.round(tour.startingPrice * 0.25));
---

<div class="group relative rounded-2xl overflow-hidden bg-white border border-[#E8E2D6] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full">
  <!-- Image Container -->
  <div class="relative aspect-[16/10] overflow-hidden bg-[#171717]">
    <img
      src={tour.heroImage}
      alt={tour.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/20"></div>

    <!-- Duration Pill Top Right -->
    <div class="absolute top-3 right-3">
      <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-white bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/15">
        {tour.durationDays}D / {tour.durationNights}N
      </span>
    </div>

    <!-- Destination Tag Top Left -->
    <div class="absolute top-3 left-3">
      <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[#F3E5AB] bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-md border border-amber-500/30">
        {tour.destinationName}
      </span>
    </div>

    <!-- Rating & Vehicle Badge at bottom of image -->
    <div class="absolute bottom-3 left-3 right-3 flex justify-between items-center text-xs text-white/90">
      <div class="flex items-center gap-1 bg-black/50 backdrop-blur-md px-2 py-0.5 rounded text-[11px]">
        <span class="text-amber-400">★</span>
        <span class="font-bold">{tour.rating}</span>
        <span class="text-white/60 text-[10px]">({tour.reviewsCount})</span>
      </div>
      <span class="text-[10px] font-mono text-emerald-300 bg-black/50 backdrop-blur-md px-2 py-0.5 rounded">
        ✓ Innova Crysta Included
      </span>
    </div>
  </div>

  <!-- Tour Info -->
  <div class="p-5 sm:p-6 flex flex-col flex-grow justify-between bg-white space-y-4">
    <div>
      <h3 class="font-bold text-lg sm:text-xl text-[#171717] leading-snug group-hover:text-[#8C733E] transition-colors line-clamp-2">
        {tour.title}
      </h3>
      <p class="text-xs text-[#6B7280] mt-2 line-clamp-2 leading-relaxed">
        {tour.overview}
      </p>

      <!-- Key Inclusions -->
      <div class="mt-3 pt-3 border-t border-[#F6F2EA] space-y-1 text-xs text-[#4B5563]">
        {tour.inclusions.slice(0, 2).map(inc => (
          <div class="flex items-start gap-1.5">
            <span class="text-emerald-600 font-bold text-xs mt-0.5">✓</span>
            <span class="line-clamp-1">{inc}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Pricing & Action -->
    <div class="pt-3 border-t border-[#E8E2D6] flex items-center justify-between">
      <div>
        <span class="text-[10px] uppercase font-mono text-[#6B7280] block">Starting from</span>
        <span class="font-bold text-lg sm:text-xl text-[#171717]">{formattedPrice}</span>
        <span class="text-[10px] text-emerald-600 block font-medium">Pay only {tokenPrice} to lock</span>
      </div>

      <a
        href={`/tours/${tour.slug}`}
        class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#D4AF37] to-[#AA771C] text-black hover:from-[#F3E5AB] hover:to-[#D4AF37] text-xs font-bold uppercase tracking-wider transition-all shadow-sm active:scale-95"
      >
        View Tour →
      </a>
    </div>
  </div>
</div>
