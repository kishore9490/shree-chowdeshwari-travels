---
// Ultra-Modern Floating Luxury Journey Dock
---

<div class="w-full max-w-5xl mx-auto relative group">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -inset-1 bg-gradient-to-r from-[#D4AF37]/30 via-amber-500/20 to-[#AA771C]/30 rounded-3xl blur-xl opacity-75 group-hover:opacity-100 transition duration-1000"></div>

  <!-- Search Card Surface -->
  <div class="relative bg-[#0E0E0E]/85 backdrop-blur-3xl rounded-2xl sm:rounded-3xl p-3 sm:p-4 border border-amber-500/30 shadow-2xl text-white">
    <form action="/tours" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
      <!-- WHERE (4 cols) -->
      <div class="lg:col-span-4 px-4 py-3 bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-amber-400/40 rounded-2xl transition-all duration-300 cursor-pointer group/item">
        <label for="search-dest" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#D4AF37] mb-0.5 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Where To?
        </label>
        <select
          id="search-dest"
          name="destination"
          class="w-full bg-transparent text-sm font-medium text-white focus:outline-none cursor-pointer pr-4 appearance-none"
        >
          <option value="" class="bg-[#121212] text-white">Select Dream Circuit</option>
          <option value="mysore-srirangapatna" class="bg-[#121212] text-white">👑 Mysore &amp; Royal Palaces</option>
          <option value="coorg-kodagu" class="bg-[#121212] text-white">☕ Coorg Coffee Country &amp; Mist</option>
          <option value="ooty-nilgiris" class="bg-[#121212] text-white">🚂 Ooty &amp; Nilgiris Mountain Rail</option>
          <option value="chikmagalur" class="bg-[#121212] text-white">🏔️ Chikmagalur &amp; Mullayanagiri</option>
          <option value="hampi-badami" class="bg-[#121212] text-white">🏛️ Hampi &amp; Badami UNESCO Trail</option>
          <option value="kerala-backwaters" class="bg-[#121212] text-white">🌴 Kerala Backwaters &amp; Munnar</option>
          <option value="kashmir-paradise" class="bg-[#121212] text-white">❄️ Kashmir Crown &amp; Gulmarg Snow</option>
          <option value="dubai-abu-dhabi" class="bg-[#121212] text-white">✨ Dubai &amp; Abu Dhabi Wonders</option>
        </select>
      </div>

      <!-- WHEN (3 cols) -->
      <div class="lg:col-span-3 px-4 py-3 bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-amber-400/40 rounded-2xl transition-all duration-300 cursor-pointer group/item">
        <label for="search-date" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#D4AF37] mb-0.5 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          When?
        </label>
        <input
          type="date"
          id="search-date"
          name="date"
          class="w-full bg-transparent text-sm font-medium text-white focus:outline-none cursor-pointer"
        />
      </div>

      <!-- TRAVELLERS & STYLE (3 cols) -->
      <div class="lg:col-span-3 px-4 py-3 bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-amber-400/40 rounded-2xl transition-all duration-300 cursor-pointer group/item">
        <label for="search-guests" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#D4AF37] mb-0.5 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          Party Size
        </label>
        <select
          id="search-guests"
          name="guests"
          class="w-full bg-transparent text-sm font-medium text-white focus:outline-none cursor-pointer appearance-none"
        >
          <option value="2" class="bg-[#121212] text-white">2 Guests &bull; Private Couple</option>
          <option value="4" class="bg-[#121212] text-white">4 Guests &bull; Luxury Family</option>
          <option value="6" class="bg-[#121212] text-white">6 Guests &bull; Innova Crysta</option>
          <option value="12" class="bg-[#121212] text-white">12+ Guests &bull; Force Urbania</option>
        </select>
      </div>

      <!-- EXPLORE BUTTON (2 cols) -->
      <div class="lg:col-span-2">
        <button
          type="submit"
          class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-[#D4AF37] via-[#F3E5AB] to-[#AA771C] text-[#121212] font-black uppercase tracking-[0.16em] text-xs shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 hover:scale-[1.02] active:scale-98 transition-all duration-300 flex items-center justify-center gap-2 h-full min-h-[52px]"
        >
          <span>Explore</span>
          <svg class="w-4 h-4 text-[#121212]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </div>
    </form>

    <!-- Quick Curated Circuit Chips -->
    <div class="mt-3 pt-3 border-t border-white/10 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-white/50 text-[11px] font-medium">Trending Luxury Escapes:</span>
      <a href="/tours?destination=mysore-srirangapatna" class="px-3 py-1 rounded-full bg-white/5 hover:bg-amber-400/20 text-white/80 hover:text-[#F3E5AB] border border-white/10 hover:border-amber-400/40 transition-colors text-[11px]">
        Mysore Palace 4D
      </a>
      <a href="/tours?destination=coorg-kodagu" class="px-3 py-1 rounded-full bg-white/5 hover:bg-amber-400/20 text-white/80 hover:text-[#F3E5AB] border border-white/10 hover:border-amber-400/40 transition-colors text-[11px]">
        Coorg Coffee Hills
      </a>
      <a href="/tours?destination=kerala-backwaters" class="px-3 py-1 rounded-full bg-white/5 hover:bg-amber-400/20 text-white/80 hover:text-[#F3E5AB] border border-white/10 hover:border-amber-400/40 transition-colors text-[11px]">
        Alleppey Private Houseboat
      </a>
      <a href="/tours?destination=kashmir-paradise" class="px-3 py-1 rounded-full bg-white/5 hover:bg-amber-400/20 text-white/80 hover:text-[#F3E5AB] border border-white/10 hover:border-amber-400/40 transition-colors text-[11px]">
        Gulmarg Gondola 6D
      </a>
    </div>
  </div>
</div>
