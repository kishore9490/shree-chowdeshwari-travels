---
// CuriousHintModal.astro - Modern Mystery Teaser Modal
---

<!-- Trigger Button -->
<div class="inline-flex items-center justify-center">
  <button
    id="open-hint-btn"
    type="button"
    aria-label="Reveal a secret hint about launch"
    class="group relative w-12 h-12 rounded-full glass-panel hover:border-amber-400 flex items-center justify-center text-amber-300 hover:text-white transition-all duration-300 hover:scale-110 shadow-[0_0_25px_rgba(245,158,11,0.25)] focus:outline-none"
  >
    <span class="font-heading text-lg font-bold group-hover:rotate-12 transition-transform">?</span>
    <span class="absolute -top-8 px-2.5 py-1 rounded-lg bg-slate-900 border border-amber-400/30 text-[10px] font-mono-tech tracking-widest text-amber-300 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-xl">
      A Secret Hint
    </span>
  </button>
</div>

<!-- Mystery Hint Modal -->
<div
  id="hint-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-2xl opacity-0 pointer-events-none transition-all duration-500 ease-out"
  aria-hidden="true"
  role="dialog"
>
  <div
    id="hint-modal-card"
    class="relative w-full max-w-sm glass-gold-panel rounded-3xl p-8 sm:p-10 text-center shadow-2xl transform scale-95 transition-all duration-500 ease-out"
  >
    <!-- Close button -->
    <button
      id="close-hint-btn"
      type="button"
      aria-label="Close hint modal"
      class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 flex items-center justify-center text-slate-300 hover:text-white transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="w-14 h-14 mx-auto rounded-2xl bg-white p-1 flex items-center justify-center mb-4 shadow-lg">
      <img src="/images/sct-logo-transparent.png" alt="Logo" class="w-full h-full object-contain" onerror="this.src='/sct-logo.jpg'" />
    </div>

    <p class="text-[10px] font-mono-tech font-bold tracking-[0.25em] uppercase text-amber-400 mb-2">
      ✦ Here's a hint... ✦
    </p>

    <div class="space-y-2 py-4 border-y border-white/10 my-4">
      <p class="font-heading text-2xl text-white font-extrabold tracking-wide">Journeys.</p>
      <p class="font-heading text-2xl text-amber-300 font-extrabold tracking-wide">Experiences.</p>
      <p class="font-heading text-2xl text-white font-extrabold tracking-wide">Memories.</p>
    </div>

    <p class="mt-4 font-signature text-2xl text-amber-300 drop-shadow-md">
      Journeys with Divine Blessings
    </p>

    <p class="mt-2 font-mono-tech text-[11px] tracking-[0.2em] text-slate-300 font-semibold">
      COMING 29.09.2026
    </p>

    <button
      id="dismiss-hint-btn"
      type="button"
      class="mt-6 px-8 py-2 rounded-full bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-xs font-semibold tracking-wider text-amber-300 transition-all"
    >
      Understood
    </button>
  </div>
</div>

<script>
  const hintModal = document.getElementById('hint-modal');
  const hintCard = document.getElementById('hint-modal-card');
  const openHintBtn = document.getElementById('open-hint-btn');
  const closeHintBtn = document.getElementById('close-hint-btn');
  const dismissHintBtn = document.getElementById('dismiss-hint-btn');

  function openHint() {
    if (!hintModal || !hintCard) return;
    hintModal.classList.remove('opacity-0', 'pointer-events-none');
    hintModal.classList.add('opacity-100', 'pointer-events-auto');
    hintCard.classList.remove('scale-95');
    hintCard.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeHint() {
    if (!hintModal || !hintCard) return;
    hintModal.classList.remove('opacity-100', 'pointer-events-auto');
    hintModal.classList.add('opacity-0', 'pointer-events-none');
    hintCard.classList.remove('scale-100');
    hintCard.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  if (openHintBtn) openHintBtn.addEventListener('click', openHint);
  if (closeHintBtn) closeHintBtn.addEventListener('click', closeHint);
  if (dismissHintBtn) dismissHintBtn.addEventListener('click', closeHint);

  if (hintModal) {
    hintModal.addEventListener('click', (e) => {
      if (e.target === hintModal) closeHint();
    });
  }
</script>
