---
// HeroCinematic.astro - Clean 100% Mobile Responsive 2026 Coming Soon
import LiveCountdown from './LiveCountdown.astro';
import DestinationCrossfade from './DestinationCrossfade.astro';
import NotifyModal from './NotifyModal.astro';
import CuriousHintModal from './CuriousHintModal.astro';
---

<section class="relative min-h-[calc(100svh-100px)] flex flex-col items-center justify-center px-3.5 xs:px-4 sm:px-6 lg:px-8 py-6 sm:py-10 text-center overflow-hidden">
  <!-- Dynamic Ambient Backdrop -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <div
      id="hero-bg-image"
      class="absolute inset-0 bg-cover bg-center opacity-20 scale-105 transition-transform duration-[3000ms] ease-out will-change-transform"
      style="background-image: url('https://images.unsplash.com/photo-1506461883276-594a12b11cf3?q=80&w=2600&auto=format&fit=crop');"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#050811]/90 via-[#050811]/70 to-[#050811]"></div>
  </div>

  <!-- Main Hero Stage -->
  <div class="relative z-10 w-full max-w-3xl mx-auto flex flex-col items-center justify-center">

    <!-- 1. Eyebrow Badge -->
    <div
      id="reveal-eyebrow"
      class="opacity-0 transform translate-y-4 transition-all duration-700 ease-out mb-3.5 sm:mb-5"
    >
      <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-white/[0.05] border border-white/15 backdrop-blur-xl shadow-md">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="text-[9px] xs:text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] sm:tracking-[0.25em] text-slate-300 font-medium">
          A New Journey Is About To Begin
        </span>
      </div>
    </div>

    <!-- 2. Official Brand Insignia Centerpiece -->
    <div
      id="reveal-logo"
      class="opacity-0 transform translate-y-6 transition-all duration-700 ease-out delay-150 mb-4 sm:mb-6 flex flex-col items-center w-full"
    >
      <div class="relative group">
        <div class="absolute -inset-3 bg-gradient-to-r from-amber-500/30 via-blue-600/30 to-amber-300/30 rounded-3xl blur-xl opacity-75 group-hover:opacity-100 transition-opacity duration-700"></div>
        <div class="relative w-[230px] xs:w-[270px] sm:w-[340px] md:w-[400px] p-2.5 xs:p-3 sm:p-4 rounded-2xl sm:rounded-3xl bg-white/95 border border-amber-300/50 shadow-2xl backdrop-blur-2xl transition-transform duration-500 group-hover:scale-[1.02]">
          <img
            src="/images/sct-logo-transparent.png"
            alt="Shree Chowdeshwari Tours & Travels Official Logo"
            class="w-full h-auto object-contain max-h-[120px] xs:max-h-[145px] sm:max-h-[190px]"
            onerror="this.src='/sct-logo.jpg'"
          />
        </div>
      </div>

      <!-- Signature Script Line -->
      <div class="mt-2.5 sm:mt-3.5 flex items-center justify-center gap-2 sm:gap-3 max-w-full px-2">
        <span class="w-6 sm:w-14 h-[1px] bg-gradient-to-r from-transparent to-amber-400 shrink-0"></span>
        <p class="font-signature text-xl xs:text-2xl sm:text-3xl md:text-4xl text-amber-300 tracking-wide drop-shadow-[0_2px_10px_rgba(245,158,11,0.5)] truncate">
          Journeys with Divine Blessings
        </p>
        <span class="w-6 sm:w-14 h-[1px] bg-gradient-to-l from-transparent to-amber-400 shrink-0"></span>
      </div>
    </div>

    <!-- 3. Four Core Pillars -->
    <div
      id="reveal-pillars"
      class="opacity-0 transform translate-y-4 transition-all duration-700 ease-out delay-300 flex flex-wrap items-center justify-center gap-1.5 xs:gap-2 sm:gap-3 mb-4 sm:mb-5 max-w-full px-1"
    >
      <span class="px-2.5 xs:px-3 py-0.5 sm:py-1 rounded-full bg-white/[0.04] border border-white/10 text-[9px] xs:text-[10px] sm:text-xs font-mono tracking-wider text-slate-300 uppercase">
        <strong class="text-amber-400 font-normal">✦</strong> EXPLORE
      </span>
      <span class="px-2.5 xs:px-3 py-0.5 sm:py-1 rounded-full bg-white/[0.04] border border-white/10 text-[9px] xs:text-[10px] sm:text-xs font-mono tracking-wider text-slate-300 uppercase">
        <strong class="text-amber-400 font-normal">✦</strong> EXPERIENCE
      </span>
      <span class="px-2.5 xs:px-3 py-0.5 sm:py-1 rounded-full bg-white/[0.04] border border-white/10 text-[9px] xs:text-[10px] sm:text-xs font-mono tracking-wider text-slate-300 uppercase">
        <strong class="text-amber-400 font-normal">✦</strong> ENJOY
      </span>
      <span class="px-2.5 xs:px-3 py-0.5 sm:py-1 rounded-full bg-white/[0.04] border border-white/10 text-[9px] xs:text-[10px] sm:text-xs font-mono tracking-wider text-slate-300 uppercase">
        <strong class="text-amber-400 font-normal">✦</strong> TOGETHER
      </span>
    </div>

    <!-- 4. Responsive Headline -->
    <div
      id="reveal-headline"
      class="opacity-0 transform translate-y-6 transition-all duration-700 ease-out delay-400 mb-4 sm:mb-6 space-y-2 sm:space-y-3 px-2"
    >
      <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        YOUR NEXT EXTRAORDINARY <br class="hidden xs:inline" />
        <span class="text-gradient-gold">JOURNEY STARTS HERE.</span>
      </h1>
      <p class="font-sans text-xs xs:text-sm sm:text-base text-slate-300 font-normal max-w-xl mx-auto leading-relaxed">
        Curating bespoke luxury holidays, sacred temple pilgrimages, and royal fleet odysseys across India & the World.
      </p>
    </div>

    <!-- 5. Official Launch Announcement -->
    <div
      id="reveal-date"
      class="opacity-0 transform translate-y-4 transition-all duration-700 ease-out delay-500 mb-4 sm:mb-6"
    >
      <div class="inline-flex items-center gap-2 xs:gap-3 px-4 xs:px-5 sm:px-6 py-1.5 sm:py-2 rounded-full glass-gold-panel shadow-lg">
        <span class="text-[9px] xs:text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] text-slate-400">LAUNCHING</span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="font-heading text-[11px] xs:text-xs sm:text-sm font-bold tracking-[0.18em] text-white">
          29 SEPTEMBER 2026
        </span>
      </div>
    </div>

    <!-- 6. Responsive Live Countdown -->
    <div
      id="reveal-countdown"
      class="opacity-0 transform translate-y-4 transition-all duration-700 ease-out delay-600 w-full"
    >
      <LiveCountdown />
    </div>

    <!-- 7. Dynamic Destination Carousel -->
    <div
      id="reveal-destinations"
      class="opacity-0 transform translate-y-4 transition-all duration-700 ease-out delay-700 w-full"
    >
      <DestinationCrossfade />
    </div>

    <!-- 8. Mobile Touch Friendly CTA and Mystery Hint -->
    <div
      id="reveal-cta"
      class="opacity-0 transform translate-y-4 transition-all duration-700 ease-out delay-800 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-5 mt-2 sm:mt-4 w-full px-2"
    >
      <NotifyModal />
      <div class="mt-1 sm:mt-0">
        <CuriousHintModal />
      </div>
    </div>

  </div>
</section>

<!-- Entrance Animation Script -->
<script>
  window.addEventListener('DOMContentLoaded', () => {
    const bg = document.getElementById('hero-bg-image');
    if (bg) {
      setTimeout(() => {
        bg.classList.remove('scale-105');
        bg.classList.add('scale-100');
      }, 50);
    }

    const elements = [
      'reveal-eyebrow',
      'reveal-logo',
      'reveal-pillars',
      'reveal-headline',
      'reveal-date',
      'reveal-countdown',
      'reveal-destinations',
      'reveal-cta'
    ];

    elements.forEach((id, idx) => {
      const el = document.getElementById(id);
      if (el) {
        setTimeout(() => {
          el.classList.remove('opacity-0', 'translate-y-4', 'translate-y-6');
          el.classList.add('opacity-100', 'translate-y-0');
        }, 120 + (idx * 120));
      }
    });
  });
</script>
